{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrisense.app/schemas/diagnosis_result.schema.json",
  "title": "DiagnosisResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "client_id",
    "crop",
    "lang",
    "quality",
    "classifier",
    "verdict",
    "weather_risk",
    "soil",
    "advice",
    "escalation"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "client_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "crop": {
      "enum": [
        "tomato",
        "potato"
      ]
    },
    "lang": {
      "enum": [
        "en",
        "hi",
        "mr"
      ]
    },
    "source": {
      "enum": [
        "server",
        "device"
      ],
      "description": "optional; device = offline check on the phone"
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "optional ISO timestamp"
    },
    "quality": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "blur",
            "brightness",
            "leaf_ratio",
            "reason_key"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "brightness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "leaf_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reason_key": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^quality\\.[a-z_]+$"
                }
              ]
            }
          }
        }
      ]
    },
    "classifier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_version",
            "top3",
            "margin"
          ],
          "properties": {
            "model_version": {
              "type": "string"
            },
            "top3": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "prob"
                ],
                "properties": {
                  "label": {
                    "$ref": "#/$defs/label"
                  },
                  "prob": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            "margin": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label",
        "confidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "likely",
            "uncertain",
            "retake",
            "unsupported"
          ]
        },
        "label": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/label"
            }
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            null
          ]
        }
      }
    },
    "weather_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rule",
        "days",
        "source",
        "fetched_at"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_assessed"
          ]
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "favourable"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "favourable": {
                "type": "boolean"
              }
            }
          }
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "fetched_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "soil": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moisture",
        "temperature_c",
        "irrigation_key",
        "card_values",
        "flags"
      ],
      "properties": {
        "moisture": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "irrigation_key": {
          "enum": [
            "wait_for_rain",
            "consider_irrigating",
            "no_action",
            "unknown"
          ]
        },
        "card_values": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/soil_card"
            }
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "advice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "steps",
        "citations"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "citation_id"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "citation_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kcc_phone"
      ],
      "properties": {
        "kcc_phone": {
          "const": "1800-180-1551"
        }
      }
    },
    "gradcam": {
      "description": "Optional heatmap of where the disease shows (likely verdicts only). method=demo until the trained model's Grad-CAM is wired.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "label",
            "image"
          ],
          "properties": {
            "method": {
              "enum": [
                "gradcam",
                "demo"
              ]
            },
            "label": {
              "type": "string"
            },
            "image": {
              "type": "string",
              "pattern": "^data:image/jpeg;base64,"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "label": {
      "type": "string",
      "pattern": "^(tomato|potato)__[a-z_]+$"
    },
    "soil_card": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ph": {
          "type": [
            "number",
            "null"
          ]
        },
        "n": {
          "type": [
            "number",
            "null"
          ],
          "description": "kg/ha"
        },
        "p": {
          "type": [
            "number",
            "null"
          ],
          "description": "kg/ha"
        },
        "k": {
          "type": [
            "number",
            "null"
          ],
          "description": "kg/ha"
        },
        "oc": {
          "type": [
            "number",
            "null"
          ],
          "description": "organic carbon %"
        }
      }
    }
  }
}
