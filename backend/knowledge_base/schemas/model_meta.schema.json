{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model_meta.json",
  "type": "object",
  "required": ["model_version", "labels", "input", "output"],
  "properties": {
    "model_version": {"type": "string", "minLength": 1},
    "arch": {"type": "string"},
    "opset": {"type": "integer"},
    "labels": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
               "items": {"type": "string", "pattern": "^(tomato|potato)__[a-z_]+$"}},
    "input": {
      "type": "object",
      "required": ["shape", "mean", "std"],
      "properties": {
        "name": {"type": "string"},
        "shape": {"const": [1, 3, 224, 224]},
        "resize": {"type": "string"},
        "color": {"const": "RGB"},
        "mean": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "std": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "output": {
      "type": "object",
      "required": ["shape"],
      "properties": {
        "name": {"type": "string"},
        "shape": {"const": [1, 13]},
        "calibrated": {"type": "boolean"},
        "temperature": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
